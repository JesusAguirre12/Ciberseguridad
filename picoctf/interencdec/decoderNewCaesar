
import string

LOWERCASE_OFFSET = ord("a")
ALPHABET = string.ascii_lowercase[:16]

def b16_decode(enc):
    plain = ""
    # Vamos de 2 en 2 porque cada carácter original se convirtió en 2 letras
    for i in range(0, len(enc), 2):
        # Conseguimos los índices de las dos letras en nuestro ALPHABET
        idx1 = ALPHABET.index(enc[i])
        idx2 = ALPHABET.index(enc[i+1])
        
        # Convertimos los índices a sus binarios de 4 bits y los juntamos
        binary1 = "{0:04b}".format(idx1)
        binary2 = "{0:04b}".format(idx2)
        binary_total = binary1 + binary2
        
        # Convertimos el binario de 8 bits de vuelta a carácter
        plain += chr(int(binary_total, 2))
    return plain

def unshift(c, k):
    t1 = ord(c) - LOWERCASE_OFFSET
    t2 = ord(k) - LOWERCASE_OFFSET
    # Restamos el desplazamiento de la clave (en base 16)
    return ALPHABET[(t1 - t2) % len(ALPHABET)]

cipher = "fegdeogdgecoeocgcgchcfcffccfca"

# Brute force a las 16 posibles llaves
for key in ALPHABET:
    dec_b16 = ""
    for c in cipher:
        dec_b16 += unshift(c, key)
    
    try:
        flag = b16_decode(dec_b16)
        # Filtramos para ver solo texto que tenga sentido (caracteres imprimibles)
        if all(char in string.printable for char in flag):
            print(f"Llave [{key}]: {flag}")
    except Exception:
        # Si da error al decodificar (caracteres extraños), pasamos de largo
        continue
