# Archivo: pattern_gen.py
# Genera 500 bytes cíclicos para crashear y hallar offset exacto.

TAM = 500
patron = b""
for i in range(TAM):
    c = (i // 3) % 10
    if i % 3 == 0:
        patron += bytes([0x41 + c % 26])  # A-Z
    elif i % 3 == 1:
        patron += bytes([0x61 + c % 26])  # a-z
    else:
        patron += bytes([0x30 + c % 10])  # 0-9

with open("pattern.bin", "wb") as f:
    f.write(patron)
print("Patrón guardado en pattern.bin")

# En gdb: run < pattern.bin; al crashear, mira EIP/RIP.
# Calcula offset con:
#   /usr/share/metasploit-framework/tools/exploit/pattern_offset.rb -q 0x41386141
# (0x41386141 es EJEMPLO del valor de EIP)
# También puedes usar el script de Metasploit (open source) o calcular manualmente.

