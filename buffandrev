[SECCIÓN 7] GDB – depurador (open source, con plugins PEDA/GEF)
================================================================================
gdb ./binario

# Comandos básicos (ejemplos):
b *0x08048400          # breakpoint en dirección (EJEMPLO)
b main                 # breakpoint en main
run < pattern.bin      # ejecutar con entrada desde archivo
info reg               # ver todos los registros
x/20x $esp             # ver 20 palabras en hex desde ESP
x/10i $eip             # ver 10 instrucciones desde EIP
set $eip = 0x08048400  # saltar a otra dirección (EJEMPLO)
disas main             # desensamblar main

# Plugins recomendados (open source):
# PEDA: git clone https://github.com/longld/peda && echo "source peda/peda.py" >> ~/.gdbinit
# GEF:  git clone https://github.com/hugsy/gef && echo "source gef/gef.py" >> ~/.gdbinit

